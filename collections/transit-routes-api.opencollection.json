{
  "opencollection": "1.0.0",
  "info": {
    "name": "Transit Alerts Routes API",
    "version": "v3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Routes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Routes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-doc.transitapp.com/public/routes",
            "params": [
              {
                "name": "network_ids",
                "value": "",
                "type": "query",
                "description": "Network IDs to get routes for"
              }
            ]
          },
          "docs": "Returns all routes for a list of given transit networks."
        }
      ]
    }
  ],
  "bundled": true
}