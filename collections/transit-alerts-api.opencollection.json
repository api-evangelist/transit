{
  "opencollection": "1.0.0",
  "info": {
    "name": "Transit Alerts API",
    "version": "v3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Alerts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Service Alerts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-doc.transitapp.com/public/alerts",
            "params": [
              {
                "name": "network_ids",
                "value": "",
                "type": "query",
                "description": "Network IDs to get alerts for"
              },
              {
                "name": "route_ids",
                "value": "",
                "type": "query",
                "description": "Route IDs to filter alerts"
              }
            ]
          },
          "docs": "Returns active service alerts and disruptions for one or more transit networks."
        }
      ]
    }
  ],
  "bundled": true
}